# ============================================================================
#  FF14 ACR 项目 —— git 忽略规则
# ============================================================================

# ---- 编译产物 ----
bin/
obj/
build/
*.dll
*.pdb
*.user
*.suo

# ---- 发布包（每个版本几十 MB，不进仓库）----
release/

# ---- 本地依赖与参考 ----
localnuget/
ref/
packages/

# ---- 快照工具的目录（有 git 之后就不需要了）----
.snapshots/

# ---- 游戏数据 dump（用 tools 里的工具随时能重新生成）----
dump.tsv
dump_*.tsv
dump2_*.tsv

# ---- 日志与临时文件 ----
*.log
build_log.txt
hw_build.txt
bw_build.txt
sd_build.txt
*.tmp

# ---- IDE ----
.vs/
.idea/
.vscode/

# ---- 系统 ----
Thumbs.db
desktop.ini

# ---- 文档抓取/分析的一次性脚本与产物 ----
doc*.json
doc*.txt
api_out.html
dump.html
probe.*
scrape*
actions.tsv
healer_actions.tsv
extract_*.py
extract_*.js
fetch_*.js
inspect_*.py
verify_*.py

# ---- 文档不进远端仓库（用户要求：只推代码本体）----
*.md

# 逆向中间产物（不该入库）——用通配符覆盖，不要写具体参考实现的名字
*_full.txt

# 官方权威数据表（用户从游戏数据导出的，本地保留即可，体积大且非本项目产物）
#   Action.csv = 技能表 / Status.csv = 状态表 —— 放在工作区根目录或任意位置都忽略
Action.csv
Status.csv
AEAssist*.md

# 反汇编输出（15 MB，随时能用参考 dll 重新生成）
.il/

# 逆向工具（本地保留，不入库）
#
# ⚠️ 为什么排除：
#    这些工具反汇编的是**参考实现**的 dll，代码里带着它的类名/文件名
#    （见 交接文档.md 的"用户偏好"：GitHub 上不能出现那些名字）。
#    它们属于我自己的工作台，不是交付物。
#
# ⚠️ 写法有讲究（这里踩过）：
#    直接写 `tools/` 会**整个目录被跳过**——git 根本不会进去看，
#    里面再写例外规则也没用。
#    必须先"取消忽略目录"，再把里面的内容逐个忽略：
tools/*
!tools/CactbotTimelineDump.py
!tools/IdAudit.py

# 一次性扫描产物（本地分析用）
emoji_*.txt

# 一次性日志分析产物（本地用）
log_analysis.txt

# cactbot 时间轴提取产物（用 tools\CactbotTimelineDump.py 生成，不入库）
cactbot_timelines/
zoneid_look.txt
verify.txt
!tools/发布打包.ps1
!tools/TimelineProbe/
tools/TimelineProbe/bin/
tools/TimelineProbe/obj/
!tools/PromptBudget.py

# 子代理/我临时切分大文件用的工作区（IL 切片、提取结果）—— 不该进版本库
#   [!] 2026-10-01 有一次提交把 11 个 .txt（约 90 万行）带进去了，
#       因为它们不在 ignore 里，而提交前用的是 git add -A。
.scratch/
