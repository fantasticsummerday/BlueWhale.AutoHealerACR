<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>SpellDump</AssemblyName>
    <RootNamespace>SpellDump</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Lumina 直接从 AEAssist.NET 包里拿，保证和游戏端版本一致 -->
    <Reference Include="Lumina">
      <HintPath>..\..\localnuget\extracted\lib\net10.0\Lumina.dll</HintPath>
    </Reference>
    <Reference Include="Lumina.Excel">
      <HintPath>..\..\localnuget\extracted\lib\net10.0\Lumina.Excel.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <!-- Lumina 的运行时依赖，AEAssist.NET 包里没带（游戏里由 Dalamud 提供） -->
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.0" />
  </ItemGroup>
</Project>
