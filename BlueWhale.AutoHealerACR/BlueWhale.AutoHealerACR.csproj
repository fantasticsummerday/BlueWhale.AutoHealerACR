<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>BlueWhale</AssemblyName>
    <RootNamespace>BlueWhale.AutoHealerACR</RootNamespace>
    <Version>0.5.7.2</Version>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- 它编译 HealerACR 的源码，那边用了指针（视线检查） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AEAssist.NET" Version="1.2.16" />
  </ItemGroup>

  <!--
    ★ **构建身份自检** ★（MSBuild 属性名**必须 ASCII** —— 中文会报 MSB5016）

    [!] 为什么需要：DLL 覆盖 **≠** 进程重载。
        本项目已经踩过"日志里的版本比部署的新版本旧"这个坑，
        而排查时我又多次假设"跑的就是刚构建的" —— **从没验证过**。

    ==> 把构建时间戳编进 dll，启动时打出来。
        日志里的时间戳和 `BlueWhale.dll` 的文件时间对得上，
        才能确定运行的是这一份。
  -->
  <Target Name="编入构建时间戳" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildStampValue>$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm:ss"))</BuildStampValue>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildStamp</_Parameter1>
        <_Parameter2>$(BuildStampValue)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!--
    ★ 直接编译 HealerACR 的源码（**一个自包含的 dll**）★

    ── 为什么是这个方案（而不是 ProjectReference）──
      试过 `ProjectReference` + 同目录 `HealerACR.dll`：能编过、体积也小
      （BlueWhale.dll 从 1716 KB 降到 233 KB），但**撤回了**，理由：

        ① 用户要的是**一个 dll** —— 少一个文件就少一处"装漏了"的可能。
        ② 体积差别对加载速度没有实际影响。
        ③ ★ **它引入了一个 0.4.2.2 从来没有过的失败模式** ★
           0.4.2.2（实测能跑的版本）是**零外部依赖**的；
           改成依赖后如果解析失败，**连职业列表都不会出现** ——
           比崩溃更难诊断。
           ==> 崩溃还没查清时，**不该同时引入新的失败点**。

    ── 那"两份静态状态"呢？──
      `HealerACR.Common.*` 在两个 dll 里各有一份，
      但**只有两个 dll 同时被加载**时才会有"两套状态"。
      实际部署目录 `D:\FF14\ACR\BlueWhale\` 里**只有 BlueWhale.dll**，
      `HealerACR.dll` 从来没部署过 ==> **运行时只有一套**。

      ==> 它是**架构整洁度**问题，不是当前崩溃的成因。
          （日志证据支持：那 16 次成功的 `可治疗队友` 用的是同一个实现。）

    ── 保留的独立改进 ──
      5 个职业入口类加了条件编译（见各文件顶部）：
          HealerACR 独立编译 -> `public class`（那个 ACR 依然可用）
          BlueWhale 编译时    -> `public abstract class`（扫描器跳过）
      ==> 将来万一 `HealerACR.dll` 真被加载，它的入口类也**不会**污染职业列表。
  -->
  <ItemGroup>
    <Compile Include="..\HealerACR\**\*.cs"
             Exclude="..\HealerACR\bin\**;..\HealerACR\obj\**" />
  </ItemGroup>

  <!--
    ★ 副本名对照表要随 dll 一起部署 ★

    记忆库提炼时要把"副本 ID"写成可读的副本名（`Data.CurrentContentFinderConditionId`
    只给 ID）。读不到这张表**不会出错**（会退回"副本#123"），
    但记忆库里全是 ID 就没法看了。

    表由 tools\DutyDump 生成（读游戏 sqpack 的 ContentFinderCondition），
    游戏大版本更新后重跑一次即可。
  -->
  <ItemGroup>
    <None Include="..\DutyNames.json" Link="DutyNames.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
