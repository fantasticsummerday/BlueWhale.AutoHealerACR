<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>BlueWhale</AssemblyName>
    <RootNamespace>BlueWhale.AutoHealerACR</RootNamespace>
    <Version>0.3.19.109</Version>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- 它编译 HealerACR 的源码，那边用了指针（视线检查） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AEAssist.NET" Version="1.2.16" />
  </ItemGroup>

  <!--
    ★ 直接编译 HealerACR 的源码 ★

    这样 BlueWhale 继承 HealerACR 的职业入口时，
    技能逻辑 / timeline / 设置界面 / 全部 resolver 都是同一份代码 ——
    改一处两边都生效，不会出现"两套逻辑慢慢分叉"。

    代价：BlueWhale.dll 会大一些（把 HealerACR 的实现也编进去了）。
          但换来的是**完全独立**：不需要 HealerACR.dll 在旁边。
  -->
  <ItemGroup>
    <Compile Include="..\HealerACR\**\*.cs"
             Exclude="..\HealerACR\bin\**;..\HealerACR\obj\**" />
  </ItemGroup>

  <!--
    ★ 副本名对照表要随 dll 一起部署 ★

    记忆库提炼时要把"副本 ID"写成可读的副本名（`Data.CurrentContentFinderConditionId`
    只给 ID）。读不到这张表**不会出错**（会退回"副本#123"），
    但记忆库里全是 ID 就没法看了。

    表由 tools\DutyDump 生成（读游戏 sqpack 的 ContentFinderCondition），
    游戏大版本更新后重跑一次即可。
  -->
  <ItemGroup>
    <None Include="..\DutyNames.json" Link="DutyNames.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
